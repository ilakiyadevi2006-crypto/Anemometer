<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_gradient">

        <!-- HEADER (Outside ScrollView) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btnMenu"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_menu"
                app:tint="#1E293B"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ANEMOMETER"
                    android:textColor="#1E293B"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Wind Measuring Device"
                    android:textColor="#64748B"
                    android:textSize="12sp"/>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintTop_toBottomOf="@id/layoutHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- DEVICE CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:background="@drawable/card_glow_bg">

                        <FrameLayout
                            android:id="@+id/imgContainer"
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintBottom_toBottomOf="parent"
                            android:background="@drawable/circle_bg">

                            <ImageView
                                android:id="@+id/imgBase"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/anemometer"
                                android:scaleType="fitCenter"
                                android:padding="10dp"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvDeviceName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Anemometer "
                            android:textColor="#1E293B"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="20dp"
                            app:layout_constraintStart_toEndOf="@id/imgContainer"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tvConnectionStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="● Disconnected"
                            android:textColor="#EF4444"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="4dp"
                            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
                            app:layout_constraintTop_toBottomOf="@id/tvDeviceName"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:gravity="top"
                            app:layout_constraintStart_toStartOf="@id/tvDeviceName"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvConnectionStatus">

                            <!-- Battery Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="top">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_battery"
                                    app:tint="#10B981"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Battery"
                                        android:textColor="#64748B"
                                        android:textSize="9sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="85%"
                                        android:textColor="#1E293B"
                                        android:textStyle="bold"
                                        android:textSize="10sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Location Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1.3"
                                android:orientation="horizontal"
                                android:gravity="top">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_location_pin"
                                    app:tint="#2563EB"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Location"
                                        android:textColor="#64748B"
                                        android:textSize="10sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Chennai,\nTamil Nadu"
                                        android:textColor="#1E293B"
                                        android:textStyle="bold"
                                        android:textSize="9sp"/>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Altitude Info -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="horizontal"
                                android:gravity="top">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_altitude"
                                    app:tint="#64748B"/>
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginStart="8dp">
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Altitude"
                                        android:textColor="#64748B"
                                        android:textSize="10sp"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="12 m"
                                        android:textColor="#1E293B"
                                        android:textStyle="bold"
                                        android:textSize="10sp"/>
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

                <!-- WIND SPEED CARD -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="@android:color/transparent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="@drawable/card_glow_bg">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="WIND SPEED"
                            android:textColor="#1E293B"
                            android:textStyle="bold"
                            android:textSize="20sp"/>

                        <FrameLayout
                            android:layout_width="360dp"
                            android:layout_height="180dp"
                            android:layout_gravity="center">

                            <ImageView
                                android:id="@+id/imgGauge"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/semicircle"
                                android:scaleType="fitCenter"/>

                            <ImageView
                                android:id="@+id/imgNeedle"
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:layout_gravity="center"
                                android:src="@drawable/needle"
                                app:tint="#2563EB"/>
                        </FrameLayout>

                        <TextView
                            android:id="@+id/txtSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="14.6"
                            android:textColor="#1E293B"
                            android:textSize="55sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="kts"
                            android:textColor="#2563EB"
                            android:textSize="22sp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="8dp"
                            android:text="Moderate Breeze"
                            android:textColor="#10B981"
                            android:textSize="18sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- BOTTOM CARDS (Wind Direction, Max Speed, Avg Speed) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:orientation="horizontal">

                    <!-- WIND DIRECTION -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1.2"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/card_glow_bg">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WIND DIRECTION"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginTop="10dp"/>

                            <FrameLayout
                                android:layout_width="80dp"
                                android:layout_height="80dp"
                                android:gravity="center">

                                <ImageView
                                    android:id="@+id/imgCompassBg"
                                    android:layout_width="105dp"
                                    android:layout_height="105dp"
                                    android:layout_marginTop="10dp"
                                    android:src="@drawable/compass1"
                                    android:scaleType="fitCenter"/>

                                <ImageView
                                    android:id="@+id/imgCompassNeedle"
                                    android:layout_width="15dp"
                                    android:layout_height="15dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/compass_needle"
                                    android:scaleType="fitCenter"
                                    android:layout_marginTop="10dp"
                                    app:tint="#2563EB"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/txtDirectionDegree"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="245°"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="20dp"/>

                            <TextView
                                android:id="@+id/txtDirection"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="WSW"
                                android:textColor="#64748B"
                                android:textSize="12sp"  />
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- MAX SPEED -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/card_glow_bg">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="MAX SPEED"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="30dp"/>

                            <FrameLayout
                                android:layout_width="95dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center">

                                <ImageView
                                    android:id="@+id/imgOrangeGauge"
                                    android:layout_width="95dp"
                                    android:layout_height="55dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/orange1"
                                    android:scaleType="fitXY"/>

                                <ImageView
                                    android:id="@+id/imgSpeedPin"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/orangepin"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/txtMaxSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="18.7 m/s"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:id="@+id/txtMaxSpeedTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="10:32 AM"
                                android:textColor="#64748B"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- AVG SPEED -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="190dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/transparent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/card_glow_bg">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AVG SPEED"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="30dp"/>

                            <FrameLayout
                                android:layout_width="95dp"
                                android:layout_height="55dp"
                                android:layout_gravity="center">

                                <ImageView
                                    android:id="@+id/imgBlueGauge"
                                    android:layout_width="95dp"
                                    android:layout_height="55dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/blue1"
                                    android:scaleType="fitXY"/>

                                <ImageView
                                    android:id="@+id/imgSpeedPin1"
                                    android:layout_width="40dp"
                                    android:layout_height="40dp"
                                    android:layout_gravity="center"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/bluepin"/>
                            </FrameLayout>

                            <TextView
                                android:id="@+id/txtAvgSpeed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="12.3 m/s"
                                android:textColor="#1E293B"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Today"
                                android:textColor="#64748B"
                                android:textSize="12sp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>

                <!-- ENVIRONMENT DATA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/card_glow_bg">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_temperature" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TEMPERATURE"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/txtTemperature"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--°C"
                                android:textColor="#FF8C42"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <androidx.cardview.widget.CardView
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        app:cardCornerRadius="25dp"
                        app:cardElevation="8dp"
                        app:cardBackgroundColor="@android:color/transparent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:background="@drawable/card_glow_bg">
                            <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/ic_humidity" />


                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="HUMIDITY"
                                android:textColor="#1E293B"
                                android:textSize="14sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:id="@+id/txtHumidity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--%"
                                android:textColor="#00A2FF"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:layout_marginTop="8dp"/>
                        </LinearLayout>

                    </androidx.cardview.widget.CardView>
                </LinearLayout>
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="8dp">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="20dp"
                        android:background="@drawable/card_glow_bg">

                        <TextView
                            android:id="@+id/tvDataLog"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATA LOG"
                            android:textColor="#1E293B"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <TextView
                            android:id="@+id/tvViewAll"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="View All"
                            android:textColor="#2563EB"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>

                        <ImageView
                            android:id="@+id/imgGraph"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:layout_marginTop="18dp"
                            android:src="@drawable/ic_line_chart_green"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvDataLog"/>

                        <TextView
                            android:id="@+id/tvRecording"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recording..."
                            android:textColor="#10B981"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toEndOf="@id/imgGraph"
                            app:layout_constraintTop_toTopOf="@id/imgGraph"
                            android:layout_marginStart="12dp"/>

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Duration: 00:25:18"
                            android:textColor="#64748B"
                            android:textSize="14sp"
                            app:layout_constraintStart_toStartOf="@id/tvRecording"
                            app:layout_constraintTop_toBottomOf="@id/tvRecording"/>

                        <LinearLayout
                            android:id="@+id/btnStop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:background="@drawable/bg_btn_stop_border"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="@id/imgGraph"
                            app:layout_constraintBottom_toBottomOf="@id/tvDuration">

                            <View
                                android:layout_width="10dp"
                                android:layout_height="10dp"
                                android:layout_marginEnd="8dp"
                                android:background="#EF4444"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STOP"
                                android:textColor="#EF4444"
                                android:textSize="16sp"
                                android:textStyle="bold"/>

                        </LinearLayout>

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

        <!-- BOTTOM NAVIGATION -->
        <LinearLayout
            android:id="@+id/bottomNavigation"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:background="#F8FAFC"
            android:orientation="horizontal"
            android:weightSum="4"
            android:paddingTop="6dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Anemometer -->
            <LinearLayout
                android:id="@+id/navAnemometer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/anemometer_icon"
                    app:tint="#2563EB"/>
            </LinearLayout>

            <!-- ADCP -->
            <LinearLayout
                android:id="@+id/navAdcp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:src="@drawable/adcp_icon"
                    app:tint="#64748B"/>
            </LinearLayout>

            <!-- GPS -->
            <LinearLayout
                android:id="@+id/navGps"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_gps"
                    app:tint="#64748B"/>
            </LinearLayout>

            <!-- Status -->
            <LinearLayout
                android:id="@+id/navStatus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_grid_filled"
                    app:tint="#64748B"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/side_menu"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:itemBackground="@drawable/nav_item_bg" />

</androidx.drawerlayout.widget.DrawerLayout>
