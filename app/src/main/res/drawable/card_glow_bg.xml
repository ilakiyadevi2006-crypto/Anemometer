<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow Layer (Simulated with a stroke and solid color) -->
    <item>
        <shape>
            <corners android:radius="26dp"/>
            <solid android:color="#202563EB"/> <!-- Semi-transparent blue for glow -->
        </shape>
    </item>

    <!-- Main Card Content -->
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape>
            <corners android:radius="24dp"/>
            <gradient
                android:angle="135"
                android:startColor="#FDFEFF"
                android:centerColor="#EDF7FF"
                android:endColor="#DCEEFF"/>
            <stroke
                android:width="1.5dp"
                android:color="#402563EB"/>
        </shape>
    </item>
</layer-list>